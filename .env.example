# Copy to .env.local for local development (`cp .env.example .env.local`).
# On Netlify, set the same names under Site configuration -> Environment variables.
# Only variables starting with NEXT_PUBLIC_ are sent to browsers. Everything else stays on the server.

# --- Site ---------------------------------------------------------------------
# The public address of the site, without a trailing slash. Used for SEO, sitemaps and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) -------------------------------------------------------
# Supabase dashboard -> Project Settings -> API Keys.
# Local values are printed by `npx supabase start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The "publishable" key (sb_publishable_...). Safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). SERVER ONLY. Creates orders and runs the Sheet import. Never expose it.
SUPABASE_SECRET_KEY=

# --- Security (required in production) ----------------------------------------------
# Random text used to hash customer IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# Protects the scheduled Sheet import endpoint. Any long random string.
CRON_SECRET=

# --- Google Sheet menu (optional) ------------------------------------------------------
# Usually set in Admin -> Settings -> Google Sheet. These are used only if the admin fields are empty
# (and by `npm run sheet:sync`). Each is a "Publish to web" CSV link for one tab.
SHEET_MENU_CSV_URL=
SHEET_CATEGORIES_CSV_URL=
SHEET_OPTIONS_CSV_URL=
SHEET_HOURS_CSV_URL=
SHEET_SETTINGS_CSV_URL=

# --- New-order notifications (optional) ---------------------------------------------
# Telegram: create a bot with @BotFather, add it to your group, see README "Telegram bot".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (free tier). Leave empty to turn email off.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# --- Error tracking & analytics (optional) ---------------------------------------------
# Sentry: turned on only when a DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
# Privacy-friendly analytics, no cookies. Set one of them.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# --- Online payments (optional, not used yet) --------------------------------------------
# Leave empty to offer cash / pay at pickup only. See src/lib/payments/README.md.
PAYMENT_PROVIDER=
